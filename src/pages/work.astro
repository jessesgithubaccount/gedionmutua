---
import '../styles/work.css';

const title = "Gedion Mutua — Work";
const description = "Work experience — Gedion Mutua, Environmental and Biosystems Engineer and Certified Sustainable Finance Expert.";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Using the Tailwind CDN build to match the original markup's utility
       classes without adding a build-time Tailwind config. For production,
       swap this for the official @astrojs/tailwind integration instead. -->
  <script src="https://cdn.tailwindcss.com" is:inline></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<div class="work-hero" id="top">

  <!-- ============================== NAV ============================== -->
  <div class="hero-nav-wrap">
    <nav class="hero-nav" aria-label="Primary navigation">
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/work" class="is-current" aria-current="page">Work</a></li>
      </ul>

      <a href="/contact" class="nav-cta">Let's Talk</a>
    </nav>
  </div>

  <main>

    <!-- ============================== HERO / INTRO ============================== -->
    <section class="relative px-5 sm:px-8 pt-10 pb-16">
      <article class="about-card reveal">
        <h1>WORK EXPERIENCE</h1>

        <div class="about-card-body">
          <p>
            Over a decade of moving between community-facing coordination and
            technical, finance-facing roles — always at the intersection of
            clean energy, sustainability and measurable impact.
          </p>
          <p>
            From regional programme delivery to client relationship management
            inside a leading bank, I've learned to translate environmental and
            social goals into language that funders, institutions and
            communities can all act on.
          </p>
          <p>
            Below is a closer look at where that experience comes from — the
            organisations, the timelines, and the skills each one built. Tap
            any role to see the detail.
          </p>
        </div>
      </article>
    </section>

  </main>
</div>

  <!-- ============================== EXPERIENCE ============================== -->
  <section id="experience" class="relative px-5 sm:px-8 py-12">
    <div class="flex items-center gap-2.5 mb-6 reveal">
      <span class="eyebrow-dot"></span>
      <h2 class="text-xs font-bold uppercase" style="letter-spacing: 0.08em; color: var(--color-foreground-muted);">
        Roles &amp; Experience
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-10 items-start">

      <div>
        <div class="flex flex-col gap-3">

            <button type="button" class="exp-card reveal" style="transition-delay: 60ms;" data-job="regional-coordinator" aria-haspopup="dialog">
              <span class="icon-chip" style="background:#fff; padding:4px; overflow:hidden;">
                <img src="data:image/png;base64," alt="Equity Group Foundation logo" style="width:100%;height:100%;object-fit:contain;" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Regional Coordinator</h3>
                <p class="text-xs font-medium mb-1.5" style="color: var(--color-foreground-muted);">Equity Group Foundation · Full-time</p>
                <p class="text-xs font-semibold" style="color: var(--color-foreground);">Nov 2020 – Present · 5 yrs 11 mos</p>
                <p class="text-xs" style="color: var(--color-foreground-muted);">Nairobi County, Kenya · On-site</p>
              </div>
              <span class="exp-card-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>

            <button type="button" class="exp-card reveal" style="transition-delay: 100ms;" data-job="relationship-officer" aria-haspopup="dialog">
              <span class="icon-chip" style="background:#fff; padding:3px; overflow:hidden;">
                <img src="data:image/png;base64," alt="Nairobi Water Company logo" style="width:100%;height:100%;object-fit:contain;" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Relationship Officer</h3>
                <p class="text-xs font-medium mb-1.5" style="color: var(--color-foreground-muted);">Nairobi Water Company · Internship</p>
                <p class="text-xs font-semibold" style="color: var(--color-foreground);">Apr 2017 – Sep 2017 · 6 mos</p>
                <p class="text-xs" style="color: var(--color-foreground-muted);">Nairobi County, Kenya</p>
              </div>
              <span class="exp-card-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>

            <button type="button" class="exp-card reveal" style="transition-delay: 140ms;" data-job="relationship-officer-operations" aria-haspopup="dialog">
              <span class="icon-chip" style="background:#fff; padding:4px; overflow:hidden;">
                <img src="data:image/png;base64," alt="Equity Bank Limited logo" style="width:100%;height:100%;object-fit:contain;" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Relationship Officer, Operations</h3>
                <p class="text-xs font-medium mb-1.5" style="color: var(--color-foreground-muted);">Equity Bank Limited · Part-time</p>
                <p class="text-xs font-semibold" style="color: var(--color-foreground);">Jun 2016 – Sep 2016 · 4 mos</p>
                <p class="text-xs" style="color: var(--color-foreground-muted);">Nairobi County, Kenya · On-site</p>
              </div>
              <span class="exp-card-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>

            <button type="button" class="exp-card reveal" style="transition-delay: 180ms;" data-job="relationship-officer-accounts" aria-haspopup="dialog">
              <span class="icon-chip" style="background:#fff; padding:4px; overflow:hidden;">
                <img src="data:image/png;base64," alt="Equity Bank Limited logo" style="width:100%;height:100%;object-fit:contain;" />
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Relationship Officer, Accounts</h3>
                <p class="text-xs font-medium mb-1.5" style="color: var(--color-foreground-muted);">Equity Bank Limited · Part-time</p>
                <p class="text-xs font-semibold" style="color: var(--color-foreground);">Mar 2015 – Sep 2015 · 7 mos</p>
                <p class="text-xs" style="color: var(--color-foreground-muted);">Kenya · On-site</p>
              </div>
              <span class="exp-card-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>

          </div>
        </div>

        <div class="hero-photo-frame reveal lg:sticky lg:top-24" style="transition-delay: 80ms;" aria-hidden="false">
          <img alt="hero-photo-frame reveal lg:sticky lg:top-24" src="/images/work-section-img.jpg" />
          <div class="hero-photo-badge">
            <p class="text-sm font-bold mb-1" style="color: var(--color-foreground);">Serena Hotel</p>
            <p class="text-xs leading-relaxed" style="color: var(--color-foreground-muted);">Nairobi, Kenya</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ============================== SKILLS ============================== -->
    <section id="skills" class="section-blend relative px-5 sm:px-8 py-12">
      <div class="flex items-center gap-2.5 mb-6 reveal">
        <span class="eyebrow-dot"></span>
        <h2 class="text-xs font-bold uppercase" style="letter-spacing: 0.08em; color: var(--color-foreground-muted);">
          Skills &amp; Expertise
        </h2>
      </div>

      <div class="reveal" style="transition-delay: 100ms;">
        <p class="text-sm sm:text-base leading-relaxed mb-6" style="color: var(--color-foreground-muted);">
          Core areas I bring to a project, from early-stage assessment
          through to on-the-ground delivery. Filter by category, or
          browse the full set.
        </p>

        <div class="skill-filter-tabs flex flex-wrap gap-2 mb-6" role="tablist" aria-label="Filter skills by category">
          <button type="button" class="skill-filter-btn is-active" data-filter="all" role="tab" aria-selected="true">All <span class="filter-count">(17)</span></button>
          <button type="button" class="skill-filter-btn" data-filter="industry" role="tab" aria-selected="false">Industry Knowledge <span class="filter-count">(7)</span></button>
          <button type="button" class="skill-filter-btn" data-filter="tools" role="tab" aria-selected="false">Tools &amp; Technologies <span class="filter-count">(6)</span></button>
          <button type="button" class="skill-filter-btn" data-filter="interpersonal" role="tab" aria-selected="false">Interpersonal Skills <span class="filter-count">(4)</span></button>
        </div>

        <!-- Skills: mirrors the full skill list, grouped by filter category -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

          <div class="skill-source-card" data-category="tools">
            <h4 class="text-sm font-bold mb-2.5" style="color: var(--color-foreground);">ESG Integration &amp; Analysis</h4>
            <div class="skill-source-row">
              <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
                <img src="data:image/png;base64," alt="Frankfurt School of Finance &amp; Management logo" style="width:100%;height:100%;object-fit:cover;" />
              </span>
              <span class="text-xs font-medium" style="color: var(--color-foreground-muted);">Frankfurt School of Finance &amp; Management</span>
            </div>
          </div>

          <div class="skill-source-card" data-category="industry">
            <h4 class="text-sm font-bold mb-2.5" style="color: var(--color-foreground);">Impact Investing</h4>
            <div class="skill-source-row">
              <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
                <img src="data:image/png;base64," alt="Frankfurt School of Finance &amp; Management logo" style="width:100%;height:100%;object-fit:cover;" />
              </span>
              <span class="text-xs font-medium" style="color: var(--color-foreground-muted);">Frankfurt School of Finance &amp; Management</span>
            </div>
          </div>

          <div class="skill-source-card" data-category="tools">
            <h4 class="text-sm font-bold mb-2.5" style="color: var(--color-foreground);">Transparency &amp; Reporting</h4>
            <div class="skill-source-row">
              <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
                <img src="data:image/png;base64," alt="Frankfurt School of Finance &amp; Management logo" style="width:100%;height:100%;object-fit:cover;" />
              </span>
              <span class="text-xs font-medium" style="color: var(--color-foreground-muted);">Frankfurt School of Finance &amp; Management</span>
            </div>
          </div>

          <div class="skill-source-card" data-category="industry">
            <h4 class="text-sm font-bold mb-2.5" style="color: var(--color-foreground);">Governance, Risk Management, and Compliance (GRC)</h4>
            <div class="skill-source-row">
              <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
                <img src="data:image/png;base64," alt="Frankfurt School of Finance &amp; Management logo" style="width:100%;height:100%;object-fit:cover;" />
              </span>
              <span class="text-xs font-medium" style="color: var(--color-foreground-muted);">Frankfurt School of Finance &amp; Management</span>
            </div>
          </div>

          <div class="skill-source-card" data-category="tools">
            <h4 class="text-sm font-bold mb-2.5" style="color: var(--color-foreground);">Renewable Energy Finance</h4>
            <div class="skill-source-row">
              <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
                <img src="data:image/png;base64," alt="Frankfurt School of Finance &amp; Management logo" style="width:100%;height:100%;object-fit:cover;" />
              </span>
              <span class="text-xs font-medium" style="color: var(--color-foreground-muted);">Frankfurt School of Finance &amp; Management</span>
            </div>
          </div>

          <div class="skill-source-card" data-category="interpersonal">
            <h4 class="text-sm font-bold mb-2.5" style="color: var(--color-foreground);">Strategy Development</h4>
            <div class="skill-source-row">
              <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
                <img src="data:image/png;base64," alt="Frankfurt School of Finance &amp; Management logo" style="width:100%;height:100%;object-fit:cover;" />
              </span>
              <span class="text-xs font-medium" style="color: var(--color-foreground-muted);">Frankfurt School of Finance &amp; Management</span>
            </div>
          </div>

          <div class="skill-source-card" data-category="tools">
            <h4 class="text-sm font-bold mb-2.5" style="color: var(--color-foreground);">Environmental Impact Assessment, Environmental Audits</h4>
            <div class="skill-source-row">
              <span class="icon-chip" style="background:var(--color-surface-soft); color:var(--color-foreground-muted); box-shadow:none;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 20h18M7 20V11M12 20V5M17 20v-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </span>
              <span class="text-xs font-medium" style="color: var(--color-foreground-muted);">Environmental Impact Assessment / Audit Expert</span>
            </div>
          </div>

          <div class="skill-source-card" data-category="industry">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Customer Service</h4>
          </div>

          <div class="skill-source-card" data-category="tools">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Microsoft Office</h4>
          </div>

          <div class="skill-source-card" data-category="interpersonal">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Management</h4>
          </div>

          <div class="skill-source-card" data-category="interpersonal">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Strategic Planning</h4>
          </div>

          <div class="skill-source-card" data-category="industry">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Project Management</h4>
          </div>

          <div class="skill-source-card" data-category="tools">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Microsoft Excel</h4>
          </div>

          <div class="skill-source-card" data-category="industry">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Sales</h4>
          </div>

          <div class="skill-source-card" data-category="interpersonal">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Public Speaking</h4>
          </div>

          <div class="skill-source-card" data-category="industry">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Marketing</h4>
          </div>

          <div class="skill-source-card" data-category="industry">
            <h4 class="text-sm font-bold" style="color: var(--color-foreground);">Research</h4>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================== ACADEMIC BACKGROUND ============================== -->
    <section id="academic" class="relative px-5 sm:px-8 py-12">
      <div class="flex items-center gap-2.5 mb-6 reveal">
        <span class="eyebrow-dot"></span>
        <h2 class="text-xs font-bold uppercase" style="letter-spacing: 0.08em; color: var(--color-foreground-muted);">
          Academic Background
        </h2>
      </div>

      <div class="reveal" style="transition-delay: 100ms;">

        <h3 class="text-sm font-bold mb-4" style="color: var(--color-foreground);">Education</h3>
        <div class="flex flex-col gap-3 mb-9">

          <div class="edu-card">
            <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
              <img src="data:image/png;base64," alt="Frankfurt School of Finance &amp; Management logo" style="width:100%;height:100%;object-fit:cover;" />
            </span>
            <div class="min-w-0">
              <h4 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Frankfurt School of Finance &amp; Management</h4>
              <p class="text-xs font-medium mb-1.5" style="color: var(--color-foreground-muted);">Certified expert in sustainable finance</p>
              <p class="text-xs font-semibold mb-2" style="color: var(--color-foreground);">Mar 2025 – Oct 2025</p>
              <div class="flex flex-wrap gap-1.5">
                <span class="skill-tag is-support" style="padding: 0.3rem 0.7rem; font-size: 0.7rem;">ESG Integration &amp; Analysis</span>
                <span class="skill-tag is-support" style="padding: 0.3rem 0.7rem; font-size: 0.7rem;">Impact Investing</span>
              </div>
            </div>
          </div>

          <div class="edu-card">
            <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
              <img src="data:image/png;base64," alt="Strathmore University logo" style="width:100%;height:100%;object-fit:cover;" />
            </span>
            <div class="min-w-0">
              <h4 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Strathmore University</h4>
              <p class="text-xs font-medium mb-1.5" style="color: var(--color-foreground-muted);">Master's degree, Sustainable energy transitions</p>
              <p class="text-xs font-semibold" style="color: var(--color-foreground);">May 2025 – May 2027</p>
            </div>
          </div>

          <div class="edu-card">
