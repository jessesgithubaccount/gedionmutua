            </div>
          </div>

          <div class="cert-card">
            <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
              <img src="data:image/png;base64," alt="ALX Africa logo" style="width:100%;height:100%;object-fit:cover;" />
            </span>
            <div class="min-w-0">
              <h4 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Data Analytics</h4>
              <p class="text-xs font-medium" style="color: var(--color-foreground-muted);">ALX Africa</p>
              <p class="text-xs" style="color: var(--color-foreground-muted);">Issued May 2025</p>
            </div>
          </div>

          <div class="cert-card">
            <span class="icon-chip" style="background:#fff; padding:0; overflow:hidden;">
              <img src="data:image/png;base64," alt="National Environment Management Authority logo" style="width:100%;height:100%;object-fit:cover;" />
            </span>
            <div class="min-w-0">
              <h4 class="text-sm font-bold leading-snug" style="color: var(--color-foreground);">Environmental Impact Assessment / Audit Expert</h4>
              <p class="text-xs font-medium" style="color: var(--color-foreground-muted);">National Environment Management Authority</p>
